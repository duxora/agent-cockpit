# ─── Authentication ───────────────────────────────────────────────────────────
# AUTH_MODE: 'local' (username + password + TOTP) or 'cloudflare' (CF Access JWT)
AUTH_MODE=local

# Required when AUTH_MODE=cloudflare: your Cloudflare Zero Trust team name
# CF_ACCESS_TEAM=yourteam

# Relay connections authenticate with this shared secret (Bearer token).
# Generate with: openssl rand -hex 32
# Mark as SECRET in Railway dashboard — never commit this value.
RELAY_SECRET=

# 64-character hex key for encrypting TOTP secrets at rest in SQLite.
# Generate with: openssl rand -hex 32
# Mark as SECRET in Railway dashboard — never commit this value.
ENCRYPTION_KEY=

# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4200

# ─── DANGER: Development only ─────────────────────────────────────────────────
# SKIP_AUTH=true disables ALL authentication. The server refuses to start if
# SKIP_AUTH=true with NODE_ENV=production. Never set this in Railway.
# SKIP_AUTH=true
