# Google OAuth Configuration
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxx
GOOGLE_REDIRECT_URI=http://localhost:4200/api/auth/google/callback
ADMIN_EMAIL=your.email@gmail.com

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/cockpit

# Node Environment
NODE_ENV=development

# Optional: Session Cookie Settings (defaults provided in code)
# SESSION_SECRET=your-random-secret-key-min-32-chars
# SESSION_MAX_AGE=2592000000 (30 days in milliseconds)

# Deprecated (no longer used - OAuth auth required)
# COCKPIT_PASSWORD=xxx
# COCKPIT_USER=xxx
